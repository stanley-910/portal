# Copy to .env.local. Server-only: never prefix with NEXT_PUBLIC_ (except the two Supabase vars at the end).
# Every var is optional; a missing one makes that provider report NOT_CONFIGURED.
# Where to get each: docs/transport/README.md § Credentials.

# Travelpayouts (flights, 12Go via TP)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=

# 12Go direct affiliate
TWELVEGO_AFFILIATE_ID=

# Taiwan TDX
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Korea data.go.kr — Decoding key
DATA_GO_KR_SERVICE_KEY=

# Trip.com affiliate (China rail link-out)
TRIPCOM_AFFILIATE_ID=

# BusOnlineTicket affiliate
BOT_REFERER_ID=

# GTFS sources
LTA_DATAMALL_ACCOUNT_KEY=
MOBILITYDB_REFRESH_TOKEN=
TRANSITLAND_API_KEY=
DATA_GOV_MY_API_TOKEN=

# Pip, the trip agent (src/lib/agent). Without it Pip still answers "where should we meet" from its tools.
DEEPSEEK_API_KEY=

# Supabase accounts. Unset = accounts off, everyone is a guest.
# Two projects, never mixed: "test" for local dev and Vercel Preview, "production" for the Vercel Production deploy
# and the demo. This file (.env.local) holds the test project. Production values live in Vercel's Production
# environment, plus .env.production.local if you need to migrate it. Use the Liveblocks dev key here and the prod
# key only in production, so test users' trips never show up in the demo's "My trips".
# Dashboard → Project Settings → API: Project URL and the publishable key. These two reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Migrations only, never read by app code. Dashboard → Connect → Session pooler URI.
# `pnpm db:migrate` uses this file's (test); `pnpm db:migrate:prod` uses .env.production.local's.
SUPABASE_DB_URL=
